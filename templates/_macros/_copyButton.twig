{# templates/macros/_copy.twig #}

{#
Macro: copy_button(...)
Erzeugt NUR den Button mit Icon + SR-Text.
- text:   String, wird in data-copy-text gesetzt (kopiert diesen Text)
- target: CSS-Selector, falls Text aus dem DOM gelesen werden soll
- attrs:  Zusätzliche HTML-Attribute als Map (optional)
#}
{% macro copyButton(text=null, target=null, attrs={},
    icon_default='fa-regular fa-copy',
    icon_success='fa-solid fa-check',
    icon_fail='fa-solid fa-triangle-exclamation',
    flash_ms=1400,
    label='Text in die Zwischenablage kopieren',
    sr='Kopieren',
    class='copy-btn')
%}
    {% set a = {
        'type':'button',
        'class': class,
        'aria-label': label,
        'data-icon-default': icon_default,
        'data-icon-success': icon_success,
        'data-icon-fail': icon_fail,
        'data-flash-ms': flash_ms
    } %}

    {% if text is not empty %}
        {% set a = a|merge({'data-copy-text': text}) %}
    {% elseif target is not empty %}
        {% set a = a|merge({'data-copy-target': target}) %}
    {% endif %}

    {% if attrs is iterable %}
        {% set a = a|merge(attrs) %}
    {% endif %}

    <button
            type="button"
            title="IST DAS SICHTBAR?"
            style="border: 5px solid red !important; background-color: yellow !important;"
    {% for k, v in a %}
        {{ k }}="{{ v }}"
    {% endfor %}
    >
    <i class="{{ icon_default|e('html_attr') }}" aria-hidden="true"></i>
    <span class="sr-only">{{ sr }}</span>
    </button>
{% endmacro %}
