{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block headline%}{{ headline|trans }}{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="d-none d-lg-block px-3 pt-1 pb-2 bg-white border-bottom">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a href="/">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item">Log In</li>
        </ol>
    </nav>
{% endblock %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center mt-5 pt-5">
            <div class="col-lg-4 col-md-6 col-12">
                <div class="text-center mb-4">
                    {# Hier könnte später Ihr Logo hin #}
                    <h1 class="h3 font-weight-normal"></h1>
                    <p class="text-muted">{{ 'Bitte melden Sie sich an.' }}</p>
                </div>
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <form method="post">
                            {# Fehlermeldung: Jetzt innerhalb der schmalen Box #}
                            {% if error %}
                                <div class="alert alert-danger text-center" role="alert">
                                    <i class="fa fa-exclamation-circle me-2"></i>
                                    {{ error.messageKey|trans(error.messageData, 'security') }}
                                </div>
                            {% endif %}
                            {# Erfolgsmeldung (Logout etc.) #}
                            {% if app.user %}
                                <div class="alert alert-info text-center">
                                    Du bist angemeldet als {{ app.user.userIdentifier }}<br>
                                    <a href="{{ path('app_logout') }}">{{ 'Ausloggen' }}</a>
                                </div>
                            {% endif %}
                            <div class="mb-3">
                                <label for="inputEmail" class="form-label text-muted small">{{ 'E-Mail Adresse' }}</label>
                                <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control form-control-lg" autocomplete="email" placeholder="name@" required autofocus>
                            </div>
                            <div class="mb-4">
                                <label for="inputPassword" class="form-label text-muted small">{{ 'Passwort' }}</label>
                                <input type="password" name="_password" id="inputPassword" class="form-control form-control-lg" autocomplete="current-password" placeholder="******" required>
                            </div>
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                            {# Checkbox optional #}
                            <div class="mb-3 form-check">
                                <input type="checkbox" class="form-check-input" name="_remember_me" id="rememberMe">
                                <label class="form-check-label small" for="rememberMe">{{ 'Angemeldet bleiben' }}</label>
                            </div>
                            <div class="d-grid gap-2">
                                <button class="btn btn-primary btn-lg" type="submit">
                                    {{ 'Anmelden' }}
                                </button>
                            </div>
                            <div class="d-grid gap-2">
                                <a href="{{ path('connect_azure_start') }}" class="btn btn-primary w-100 mt-2">
                                    <i class="fab fa-microsoft"></i> Login mit Windows Account
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="text-center mt-3 text-muted small">
                    &copy; {{ 'now'|date('Y') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}