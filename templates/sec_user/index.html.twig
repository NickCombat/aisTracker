{% extends 'base.html.twig' %}

{% block title %}{{ 'Benutzerverwaltung'|trans }}{% endblock %}

{% block headline%}{{ headline|trans }}{% endblock %}

{% block breadcrumb %}
    {{ include('_includes/_breadcrumb.html.twig') }}
{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>{{ 'Benutzerverwaltung'|trans }}</h1>
        <a href="{{ path('admin_user_new') }}" class="btn btn-primary">
            <i class="fas fa-user-plus"></i> {{ 'Neuer Benutzer'|trans }}
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-light">
                <tr>
                    <th>{{ 'ID'|trans }}</th>
                    <th>{{ 'Name'|trans }}</th>
                    <th>{{ 'E-Mail'|trans }}</th>
                    <th>{{ 'Rollen'|trans }}</th>
                    <th>{{ 'Aktionen'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for user in sec_users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td>{{ user.firstname }} {{ user.lastname }}</td>
                        <td>{{ user.email }}</td>
                        <td>
                            {% for role in user.roles %}
                                {% if role == 'ROLE_ADMIN' %}
                                    <span class="badge bg-danger">{{ 'Admin'|trans }}</span>
                                {% elseif role == 'ROLE_USER' %}
                                    <span class="badge bg-secondary">{{ 'User'|trans }}</span>
                                {% else %}
                                    <span class="badge bg-info">{{ role }}</span>
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td>
                            <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-outline-secondary">
                                <i class="fas fa-edit"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-4">{{ 'Keine Benutzer gefunden'|trans }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
