                {{ ui.navItem(path('projekt_bearbeiten', {'id': projekt_id}), 'Projekt bearbeiten', 0, 'fa-regular fa-pen-to-square', app.request.attributes.get('_route') == 'projekt_bearbeiten') }}

            {{ ui.navItem(path('hafen_liste', {'id': projekt_id}), 'Häfen', 0, 'fa-solid fa-anchor-circle-check', app.request.attributes.get('_route') == 'hafen_liste') }}
            {{ ui.navItem(path('nav_liste', {'id': projekt_id}), 'Navpunkte', 0, 'fa-solid fa-compass-drafting', app.request.attributes.get('_route') == 'nav_liste') }}
