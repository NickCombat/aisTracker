    <div class="sidebar-sticky">
        <ul class="nav flex-column">
            <li class="nav-item">
                <b>{{ 'calendar.week_short'|trans({ '%weekNumber%': "now"|date("W") }) }}</b> <span id="date-time-display" data-days-json="{{ translated_days|json_encode }}"></span>
            </li>
            {{ ui.navItem(path( 'projekt_deails', {'id': projekt_id}), 'Projektdaten', 0, 'fa fa-ship', app.request.attributes.get('_route') == 'projekt_deails') }}
