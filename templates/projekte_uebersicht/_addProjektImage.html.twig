<style>
    .thumbnail {
        width: 100px;
        height: 100px;
        object-fit: cover;
        cursor: pointer;
        margin: 5px;
    }
    .modal-img {
        max-width: 60vw; /* Halbe Bildschirmbreite */
        max-height: 60vh; /* Halbe Bildschirmhöhe */
        width: auto;
        height: auto;
        object-fit: contain; /* Bild skalieren, um den Container zu füllen */
    }
    .full-size-img {
        max-width: 100vw; /* Volle Bildschirmbreite */
        max-height: 100vh; /* Volle Bildschirmhöhe */
        width: auto;
        height: auto;
        object-fit: contain; /* Bild skalieren, um den Container zu füllen */
    }
    @media (min-width: 992px) {
        .modal-lg,.modal-xl {
            max-width: 1000px;
        }
    }
</style>
<div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="galleryModalLabel">Projekt Bildergalerie</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            <div class="modal-footer">
                {{ form(form) }}
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function() {
        $('.thumbnail').on('click', function() {
            var largeImageSrc = $(this).data('large');
            $('#mainImage').attr('src', largeImageSrc).removeClass('full-size-img').addClass('modal-img');
            $('#toggleSizeBtn').text('Vollbild anzeigen');
        });

        $('#toggleSizeBtn').on('click', function() {
            var mainImage = $('#mainImage');
            if (mainImage.hasClass('modal-img')) {
                mainImage.removeClass('modal-img').addClass('full-size-img');
                $(this).text('Halbe Bildschirmgröße anzeigen');
            } else {
                mainImage.removeClass('full-size-img').addClass('modal-img');
                $(this).text('Vollbild anzeigen');
            }
        });
    });
</script>